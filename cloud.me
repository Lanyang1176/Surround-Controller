## 目录结构

```
/
├── App.tsx              # 主应用入口 + 布局
├── types.ts             # TypeScript 类型定义
├── index.html           # HTML 入口 + 全局样式变量
├── components/
│   ├── Visualizer.tsx           # 扬声器俯视图可视化
│   ├── SourceConfigEditor.tsx   # 输入源配置面板
│   ├── SourceStrip.tsx          # 输入源条目 UI
│   ├── OutputStrip.tsx          # 输出条目 UI
│   ├── Knob.tsx                 # 可拖拽旋钮组件
│   ├── Meter.tsx                # 电平表组件
│   ├── HardwareUI.tsx           # 硬件风格基础组件
│   └── OutputConfigEditor/
│       ├── index.tsx            # 输出配置编辑器主入口
│       ├── ParametricEQ.tsx     # 参量 EQ 编辑器
│       ├── GraphicEQ.tsx        # 图形 EQ 编辑器
│       ├── BassManagement.tsx   # 低音管理面板
│       ├── ChannelRouting.tsx   # 通道路由矩阵
│       └── SpeakerLayoutSelector.tsx # 布局选择器
└── lib/
    └── utils.ts          # 工具函数 (cn, clsx)
```

